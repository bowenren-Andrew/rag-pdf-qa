# 复制本文件为 .env 后填入你自己的配置（v3：多用户版）

# 数据库连接串。
# 本地开发可以留空，程序会自动使用项目下的 sqlite 文件 app.db；
# 部署到 Streamlit Cloud 时填 Supabase 的 Postgres 连接串（见 README「云端部署需要配置的 Secrets」）。
DATABASE_URL=

# 用于加密保存用户 API Key 的 Fernet 密钥（本地与云端都必须配置）。
# 生成命令：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# 说明：v3 起下面两个变量已废弃
#   DEEPSEEK_API_KEY —— 改由每位用户在「⚙️ 设置」页填写自己的 Key（加密入库）
#   APP_PASSWORD     —— 改由账号登录体系取代
