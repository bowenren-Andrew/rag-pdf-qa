# 复制本文件为 .env 后填入你自己的配置（v3：多用户版）

# 数据库连接串。
# 本地开发可以留空，程序会自动使用项目下的 sqlite 文件 app.db；
# 部署到 Streamlit Cloud 时填 Supabase 的 Postgres 连接串（见 README「云端部署需要配置的 Secrets」）。
DATABASE_URL=

# 邮箱验证码 HMAC 的服务端密钥（本地与云端都必须配置）。
# 生成命令：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

# 平台统一 DeepSeek Key：所有用户共用，用户不用填 Key。
# 必须是 DeepSeek 官方 Key（接口固定 https://api.deepseek.com，模型固定 deepseek-flash）。
DEEPSEEK_API_KEY=

# v3.9 防刷注册：Cloudflare Turnstile（免费人机验证）
# Site Key 会展示在注册页，可以公开；Secret Key 只能放这里或 Streamlit Secrets，绝不写进代码/日志。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# v3.9 邮箱验证码：SMTP 发件配置（Gmail/QQ/企业邮箱的授权码都填在 SMTP_PASSWORD）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# 说明：APP_PASSWORD 已废弃，改由账号登录体系取代。
